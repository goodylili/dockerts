# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.

# ---------------------------------------------------------------- Postgres --
POSTGRES_USER=biodata
POSTGRES_PASSWORD=biodata
POSTGRES_DB=biodata
# Host port for the container's 5432 (5433 avoids clashing with a local Postgres).
POSTGRES_HOST_PORT=5433

# ----------------------------------------------------------------- Backend --
# Inside compose the DB is reachable as `db:5432`.
DATABASE_URL=postgresql+psycopg://biodata:biodata@db:5432/biodata
# For local dev without Docker, point at the published host port instead:
# DATABASE_URL=postgresql+psycopg://biodata:biodata@localhost:5433/biodata
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
BACKEND_HOST_PORT=8000

# ---------------------------------------------------------------- Frontend --
# Server-side only; the browser never talks to the backend directly.
BACKEND_URL=http://backend:8000
# Local dev without Docker:
# BACKEND_URL=http://localhost:8000
FRONTEND_HOST_PORT=3000

# --------------------------------------------------------------------- CI ---
# Used by the backend test suite in CI / locally.
TEST_DATABASE_URL=postgresql+psycopg://biodata:biodata@localhost:5433/biodata_test
